{
  "name": "sanity-schema-impact",
  "version": "0.1.0-beta.1",
  "description": "Shows how a Sanity schema change affects existing content on every pull request.",
  "keywords": [
    "sanity",
    "sanity-io",
    "schema",
    "migration",
    "github-action",
    "pull-request",
    "groq",
    "cms"
  ],
  "license": "MIT",
  "author": "Shehab Hasan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shehabemon/sanity-schema-impact.git"
  },
  "homepage": "https://github.com/shehabemon/sanity-schema-impact#readme",
  "bugs": {
    "url": "https://github.com/shehabemon/sanity-schema-impact/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "sanity-schema-impact": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "seed": "tsx --env-file-if-exists=.env fixtures/seed.ts"
  },
  "dependencies": {
    "@sanity/client": "^8.17.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.20.7",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
